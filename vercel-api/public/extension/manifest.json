{
  "manifest_version": 3,
  "name": "Instagram MCP Sync",
  "version": "1.0.0",
  "description": "Sends your Instagram sessionid from this browser to your own Instagram MCP server, encrypted.",
  "permissions": ["cookies", "storage", "notifications"],
  "host_permissions": ["https://www.instagram.com/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Instagram MCP Sync" },
  "options_page": "options.html",
  "icons": { "128": "icon.png" }
}
